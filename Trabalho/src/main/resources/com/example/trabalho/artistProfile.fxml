<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #1b1c1f;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.trabalho.artistProfileController">
   <children>
      <ImageView fitHeight="185.0" fitWidth="169.0" layoutX="174.0" layoutY="49.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@imagens/imgIcon.png" />
         </image>
      </ImageView>
      <Label alignment="CENTER" layoutX="383.0" layoutY="91.0" prefHeight="84.0" prefWidth="369.0" text="Nome do artista" textFill="WHITE">
         <font>
            <Font size="26.0" />
         </font>
      </Label>
      <ScrollPane layoutX="258.0" layoutY="288.0" prefHeight="467.0" prefWidth="683.0" style="-fx-background-color: #1b1c1f; -fx-background: #1b1c1f;">
         <content>
            <VBox prefHeight="464.0" prefWidth="681.0" style="-fx-background-color: #1b1c1f;">
               <children>
                  <Pane prefHeight="98.0" prefWidth="681.0">
                     <children>
                        <ImageView fitHeight="53.0" fitWidth="75.0" layoutX="22.0" layoutY="23.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@imagens/musicIcon.png" />
                           </image>
                        </ImageView>
                        <Label alignment="CENTER" layoutX="160.0" layoutY="24.0" prefHeight="53.0" prefWidth="270.0" text="Nome da música" textFill="WHITE">
