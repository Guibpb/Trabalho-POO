<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #1b1c1f;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.trabalho.musicConfigScreenController">
   <children>
      <Button layoutX="119.0" layoutY="66.0" mnemonicParsing="false" onAction="#editMusicName" prefHeight="50.0" prefWidth="48.0" style="-fx-background-color: none;">
         <graphic>
            <ImageView fitHeight="40.0" fitWidth="33.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@imagens/editIcon.png" />
               </image>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </ImageView>
         </graphic>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button layoutX="119.0" layoutY="175.0" mnemonicParsing="false" onAction="#editMusicGenre" prefHeight="50.0" prefWidth="48.0" style="-fx-background-color: none;">
         <graphic>
            <ImageView fitHeight="40.0" fitWidth="33.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@imagens/editIcon.png" />
               </image>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </ImageView>
         </graphic>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#goBack" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: none;">
         <graphic>
            <ImageView fitHeight="44.0" fitWidth="42.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@imagens/goBack.png" />
               </image>
            </ImageView>
         </graphic>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <MenuButton fx:id="genreMenu" disable="true" layoutX="168.0" layoutY="174.0" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: none;" text="Gênero" textFill="WHITE">
         <items>
            <MenuItem mnemonicParsing="false" text="Rap" />
            <MenuItem mnemonicParsing="false" text="Funk" />
            <MenuItem mnemonicParsing="false" text="Rock" />
         </items>
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </MenuButton>
      <Button layoutX="463.0" layoutY="14.0" mnemonicParsing="false" onAction="#deleteMusic" prefHeight="34.0" style="-fx-background-color: #cc041b;" text="Excluir Música" textFill="WHITE">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button layoutX="363.0" layoutY="293.0" mnemonicParsing="false" onAction="#edit" prefHeight="42.0" prefWidth="118.0" style="-fx-background-color: #4CAF50;" text="Aplicar" textFill="#1b1c1f">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Button>
      <Button layoutX="120.0" layoutY="293.0" mnemonicParsing="false" onAction="#goBack" prefHeight="43.0" style="-fx-background-color: #F44336;" text="Descartar" textFill="#1b1c1f">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Button>
      <TextField fx:id="musicName" disable="true" editable="false" layoutX="179.0" layoutY="74.0" prefHeight="35.0" prefWidth="260.0" promptText="Nome da música">
         <font>
            <Font size="16.0" />
         </font>
      </TextField>
