<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #1b1c1f;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.trabalho.artistMusicsScreenController">
   <children>
      <ScrollPane layoutX="201.0" layoutY="25.0" maxHeight="630.0" prefWidth="892.0" style="-fx-background-color: #1b1c1f; -fx-background: #1b1c1f;" stylesheets="@styleAllSongsScreen.css">
         <content>
            <VBox fx:id="vboxSongs" prefWidth="814.0" />
         </content>
      </ScrollPane>
      <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#goBack" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: none;">
         <graphic>
            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@imagens/goBack.png" />
               </image>
            </ImageView>
         </graphic>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button fx:id="musicsDataBtn" layoutX="227.0" layoutY="688.0" mnemonicParsing="false" onAction="#switchToSceneMusicsData" style="-fx-background-color: none;" stylesheets="@styleArtistMusicsScreen.css" text="Gerar Relatório" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <Button fx:id="addMusicBtn" layoutX="789.0" layoutY="688.0" mnemonicParsing="false" onAction="#switchToSceneAddMusic" style="-fx-background-color: none;" stylesheets="@styleArtistMusicsScreen.css" text="Adicionar Música" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
   <cursor>
      <Cursor fx:constant="HAND" />
   </cursor>
</AnchorPane>
