                  <ImageView fitHeight="39.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagens/allMusics.png" />
                     </image>
                  </ImageView>
               </graphic>
               <tooltip>
                  <Tooltip text="Todas as músicas" />
               </tooltip>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button layoutX="14.0" layoutY="289.0" mnemonicParsing="false" onAction="#switchToSceneAllPlaylists" prefHeight="46.0" prefWidth="62.0" style="-fx-background-color: none;">
               <graphic>
                  <ImageView fitHeight="39.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagens/allPlaylists.png" />
                     </image>
                  </ImageView>
               </graphic>
               <tooltip>
                  <Tooltip text="Todas as playlists" />
               </tooltip>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button fx:id="createMusicButton" layoutX="13.0" layoutY="431.0" mnemonicParsing="false" onAction="#switchToSceneMusicsConfig" prefHeight="46.0" prefWidth="62.0" style="-fx-background-color: none;">
               <graphic>
                  <ImageView fitHeight="39.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagens/addMusic.png" />
                     </image>
                  </ImageView>
               </graphic>
               <tooltip>
                  <Tooltip text="Músicas do Artista" />
               </tooltip>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </Pane>
      <ScrollPane hbarPolicy="NEVER" layoutX="138.0" layoutY="187.0" maxHeight="600.0" prefWidth="959.0" style="-fx-background: #1b1c1f; -fx-background-color: #1b1c1f;" stylesheets="@styleInitialScreen.css">
         <content>
            <VBox fx:id="vbox" alignment="CENTER" spacing="30.0" style="-fx-background-color: #1b1c1f;" />
         </content>
         <padding>
            <Insets bottom="10.0" />
         </padding>
      </ScrollPane>
      <Button fx:id="newPlaylistBtn" layoutX="881.0" layoutY="106.0" mnemonicParsing="false" onAction="#switchToSceneCreatePlaylist" prefHeight="14.0" prefWidth="174.0" style="-fx-background-color: none;" stylesheets="@styleInitialScreen.css" text="Nova Playlist" textFill="WHITE">
