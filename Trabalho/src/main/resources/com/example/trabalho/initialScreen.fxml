            <Font name="System Bold" size="20.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <ImageView fx:id="admIcon" fitHeight="36.0" fitWidth="37.0" layoutX="863.0" layoutY="17.0" pickOnBounds="true" preserveRatio="true" style="-fx-background: none;">
         <image>
            <Image url="@imagens/admIcon.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="42.0" fitWidth="36.0" layoutX="1055.0" layoutY="108.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@imagens/addPlaylist.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
