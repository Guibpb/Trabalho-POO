<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #1b1c1f;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.trabalho.initialScreenController">
   <children>
      <Pane layoutX="899.0" layoutY="14.0" prefHeight="40.0" prefWidth="288.0">
         <children>
            <ImageView fitHeight="37.0" fitWidth="38.0" layoutX="14.0" layoutY="2.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@imagens/imgIcon.png" />
               </image>
            </ImageView>
            <Label fx:id="username" alignment="CENTER" layoutX="73.0" layoutY="1.0" prefHeight="39.0" prefWidth="160.0" text="Nome do usuário" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Button layoutX="233.0" layoutY="-6.0" mnemonicParsing="false" onAction="#switchToSceneConfiguration" prefHeight="21.0" prefWidth="23.0" style="-fx-background-color: none;">
               <graphic>
                  <ImageView fitHeight="50.0" fitWidth="44.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagens/configurationIcon.png" />
                     </image>
                  </ImageView>
               </graphic>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
               <tooltip>
                  <Tooltip text="Conigurações" />
               </tooltip>
            </Button>
         </children>
      </Pane>
      <Pane layoutY="187.0" prefHeight="501.0" prefWidth="90.0">
         <children>
            <Button layoutX="12.0" layoutY="24.0" mnemonicParsing="false" onAction="#switchToSceneFriends" prefHeight="46.0" prefWidth="62.0" style="-fx-background-color: none;">
               <graphic>
                  <ImageView fitHeight="48.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagens/friendsIcon.png" />
                     </image>
                  </ImageView>
               </graphic>
               <tooltip>
                  <Tooltip text="Amigos" />
               </tooltip>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button layoutX="14.0" layoutY="160.0" mnemonicParsing="false" onAction="#switchToSceneAllSongs" prefHeight="46.0" prefWidth="62.0" style="-fx-background-color: none;">
